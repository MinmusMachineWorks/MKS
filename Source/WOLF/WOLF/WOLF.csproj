<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WOLF</RootNamespace>
    <AssemblyName>USI_WOLF</AssemblyName>
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)../../../FOR_RELEASE/GameData/UmbraSpaceIndustries/WOLF/</KSPBT_ModRoot>
  </PropertyGroup>

  <ItemGroup>
    <ModReference Include="USITools">
      <DLLPath>GameData/000_USITools/USITools.dll</DLLPath>
      <CKANIdentifier>USITools</CKANIdentifier>
    </ModReference>
    <ModReference Include="USIToolsUI">
      <DLLPath>GameData/000_USITools/USIToolsUI.dll</DLLPath>
      <CKANIdentifier>USITools</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <ItemGroup>
    <!-- WOLFUI copies itself into the WOLF folder; don't duplicate it here. -->
    <ProjectReference Include="../WOLFUI/WOLFUI.csproj" Private="false" />
  </ItemGroup>

</Project>
